# ==============================================================================
# Sprout AI Gateway configuration
# Copy to .env (or run install.sh) and fill in the values marked <...>.
# Never commit a real .env file.
# ==============================================================================

# App identity
ENVIRONMENT=dev
GATEWAY_NAME=sprout-ai-gateway

# ------------------------------------------------------------------------------
# Database (MySQL)
# With docker-compose.yml, MYSQL_HOST is overridden to the bundled "db" container.
# To use your own MySQL server instead, set MYSQL_HOST and uncomment COMPOSE_FILE
# (install.sh does both when you choose not to add MySQL to docker compose).
# ------------------------------------------------------------------------------
MYSQL_HOST=<mysql-host>
MYSQL_PORT=3306
MYSQL_DATABASE=<mysql-database>
MYSQL_USER=<mysql-user>
MYSQL_PASSWORD=<mysql-password>
# COMPOSE_FILE=docker-compose.external-db.yml

# Secret used to hash gateway API keys. Use a long random value and don't change it
# after keys are issued: existing keys stop working if it changes.
API_KEY_HASH_PEPPER=<api-key-hash-pepper>

# ------------------------------------------------------------------------------
# First admin account (built-in login, no external identity provider)
# Created on first start when there are no users. Change the password after
# signing in; these values are ignored once users exist.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<change-me-at-least-10-chars>
ADMIN_NAME=Administrator
SESSION_TTL_HOURS=12
# auto = Secure cookie when served over HTTPS (or behind a proxy sending X-Forwarded-Proto: https)
SESSION_COOKIE_SECURE=auto
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15
# Only needed if the web UI is hosted on a different origin than the gateway.
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Single sign-on for the web UI (OpenID Connect, e.g. Auth0). Optional.
# Gateway API keys are not affected. See "Single sign-on" in README.md.
# ------------------------------------------------------------------------------
# local = email and password only, oidc = single sign-on only, both = either.
AUTH_MODE=local
# Auth0: a "Regular Web Application" with callback URL <PUBLIC_BASE_URL>/auth/oidc/callback
# and allowed logout URL <PUBLIC_BASE_URL>/login. PUBLIC_BASE_URL must be set.
# Example issuer: https://your-tenant.us.auth0.com/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Shown on the sign-in button ("Continue with Auth0")
OIDC_PROVIDER_LABEL=Auth0
OIDC_SCOPES=openid profile email
# ID token claim with the user's roles (added by an Auth0 post-login Action). Users with
# OIDC_ADMIN_ROLE are admins; for single sign-on users the role can't be changed in the gateway.
OIDC_ROLES_CLAIM=https://ai-gateway/roles
OIDC_ADMIN_ROLE=ai-gateway-admin
# With AUTH_MODE=oidc, local admin accounts can still sign in at /login?local=1 (break-glass).
OIDC_LOCAL_ADMIN_FALLBACK=true

# Default model used by the gateway when applicable
DEFAULT_CHAT_MODEL=claude-sonnet

# Logging controls
LOG_PROMPTS=false
LOG_RESPONSES=false

# ------------------------------------------------------------------------------
# Model providers (fill in the ones you use)
# ------------------------------------------------------------------------------
# AWS / Bedrock
AWS_REGION=us-east-2
BEDROCK_REGION=us-east-2
AWS_BEARER_TOKEN_BEDROCK=<bedrock-token>
# Claude Code on Bedrock: anthropic-beta values forwarded to Bedrock; others are dropped.
BEDROCK_ALLOWED_BETAS=interleaved-thinking-2025-05-14,context-1m-2025-08-07

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=<azure-openai-endpoint>
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_VERSION=2023-06-01

# Google Gemini (native API on /gemini, use provider "gemini" in Model Routes)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# DeepSeek (native API on /deepseek, use provider "deepseek" in Model Routes)
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Perplexity (native API on /perplexity, use provider "perplexity" in Model Routes)
PERPLEXITY_API_KEY=<your-perplexity-api-key>
PERPLEXITY_BASE_URL=https://api.perplexity.ai
# Cost per Perplexity Search API request (USD); token-based calls use Perplexity's reported cost.
PERPLEXITY_SEARCH_COST_USD=0.005

# DigitalOcean serverless inference (model library). Use provider "digitalocean" in Model Routes
# with the model slugs from GET https://inference.do-ai.run/v1/models.
DIGITALOCEAN_INFERENCE_KEY=<your-digitalocean-model-access-key>
DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run

# ------------------------------------------------------------------------------
# Budgets, usage alerts and daily summary emails
# ------------------------------------------------------------------------------
# Reject requests (HTTP 429) once an API key reaches 100% of its monthly budget or token limit.
ENFORCE_MONTHLY_BUDGETS=false
# Default alert thresholds in percent. Admins can override them per API key.
USAGE_ALERT_THRESHOLDS=80,90,100
SCHEDULER_ENABLED=true
ALERT_CHECK_INTERVAL_SECONDS=300
DAILY_SUMMARY_HOUR_UTC=8
# Public URL of the gateway, used for links in emails, e.g. https://ai-gateway.example.com
PUBLIC_BASE_URL=

# SMTP server for alert and summary emails. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ai-gateway@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# Optional Purview / Event Hub integration
# ------------------------------------------------------------------------------
PURVIEW_EVENTHUB_URL=
PURVIEW_EVENTHUB_KEY=
