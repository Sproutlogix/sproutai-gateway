# ==============================================================================
# Sprout AI Gateway configuration
# Copy to .env (or run install.sh) and fill in the values marked <...>.
# Never commit a real .env file.
# ==============================================================================

# App identity
ENVIRONMENT=dev
GATEWAY_NAME=sprout-ai-gateway

# ------------------------------------------------------------------------------
# Database (MySQL)
# With docker compose, MYSQL_HOST is overridden to the bundled "db" container.
# ------------------------------------------------------------------------------
MYSQL_HOST=<mysql-host>
MYSQL_PORT=3306
MYSQL_DATABASE=<mysql-database>
MYSQL_USER=<mysql-user>
MYSQL_PASSWORD=<mysql-password>

# Secret used to hash gateway API keys. Use a long random value and don't change it
# after keys are issued: existing keys stop working if it changes.
API_KEY_HASH_PEPPER=<api-key-hash-pepper>

# ------------------------------------------------------------------------------
# First admin account (built-in login, no external identity provider)
# Created on first start when there are no users. Change the password after
# signing in; these values are ignored once users exist.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<change-me-at-least-10-chars>
ADMIN_NAME=Administrator
SESSION_TTL_HOURS=12
# auto = Secure cookie when served over HTTPS (or behind a proxy sending X-Forwarded-Proto: https)
SESSION_COOKIE_SECURE=auto
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15
# Only needed if the web UI is hosted on a different origin than the gateway.
CORS_ORIGINS=

# Default model used by the gateway when applicable
DEFAULT_CHAT_MODEL=claude-sonnet

# Logging controls
LOG_PROMPTS=false
LOG_RESPONSES=false

# ------------------------------------------------------------------------------
# Model providers (fill in the ones you use)
# ------------------------------------------------------------------------------
# AWS / Bedrock
AWS_REGION=us-east-2
BEDROCK_REGION=us-east-2
AWS_BEARER_TOKEN_BEDROCK=<bedrock-token>
# Claude Code on Bedrock: anthropic-beta values forwarded to Bedrock; others are dropped.
BEDROCK_ALLOWED_BETAS=interleaved-thinking-2025-05-14,context-1m-2025-08-07

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=<azure-openai-endpoint>
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_VERSION=2023-06-01

# ------------------------------------------------------------------------------
# Budgets, usage alerts and daily summary emails
# ------------------------------------------------------------------------------
# Reject requests (HTTP 429) once an API key reaches 100% of its monthly budget or token limit.
ENFORCE_MONTHLY_BUDGETS=false
# Default alert thresholds in percent. Admins can override them per API key.
USAGE_ALERT_THRESHOLDS=80,90,100
SCHEDULER_ENABLED=true
ALERT_CHECK_INTERVAL_SECONDS=300
DAILY_SUMMARY_HOUR_UTC=8
# Public URL of the gateway, used for links in emails, e.g. https://ai-gateway.example.com
PUBLIC_BASE_URL=

# SMTP server for alert and summary emails. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ai-gateway@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# Optional Purview / Event Hub integration
# ------------------------------------------------------------------------------
PURVIEW_EVENTHUB_URL=
PURVIEW_EVENTHUB_KEY=
